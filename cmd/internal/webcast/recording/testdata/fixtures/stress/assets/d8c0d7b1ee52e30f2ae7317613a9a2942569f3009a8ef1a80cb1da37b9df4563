body { font: 13px/1.3 -apple-system, Helvetica, sans-serif; margin: 0; background: #f6f6f2; }
header { display: flex; gap: 16px; align-items: center; padding: 6px 12px; background: #223; color: #eee; }
h1 { font-size: 18px; margin: 0; }
.late { font-family: LateFace, Georgia, serif; font-size: 20px; }
.spin { width: 20px; height: 20px; background: orange; animation: spin 1.2s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
main { display: flex; gap: 12px; padding: 8px; }
.grid { flex: 1; height: 720px; overflow: hidden; }
table { border-collapse: collapse; width: 100%; font-size: 11px; }
td, th { border: 1px solid #ccc; padding: 1px 4px; }
.pill { padding: 0 4px; border-radius: 6px; background: #ddeeff; }
.side { width: 340px; display: flex; flex-direction: column; gap: 6px; }
.box { padding: 6px; background: #eee; }
#scroller { height: 80px; overflow: auto; border: 1px solid #999; background: white; }
iframe { border: 1px solid #555; }
