# Repo-specific Makefile targets.
# This file is included by Makefile — add your own targets here.

# Shared native fleet qualification; ordinary suites retain the portable tests.
.PHONY: test-couch-fleet
test-couch-fleet:
	PAIR_NATIVE_COUCH_FLEET=1 go test ./cmd/couch -run '^TestDisposableCouchFleet$$' -count=1 -v -timeout=12m

# Share Go package compilation across worktrees without discarding caller flags
# (for example -p=3). Set PAIR_GO_TRIMPATH= for diagnostic source paths.
PAIR_GO_TRIMPATH ?= -trimpath
GOFLAGS ?= $(shell go env GOFLAGS)
override GOFLAGS := $(strip $(GOFLAGS) $(if $(filter $(PAIR_GO_TRIMPATH),$(GOFLAGS)),,$(PAIR_GO_TRIMPATH)))
export GOFLAGS

# Test goals never inherit a live session's identity (pair#436). Agents run
# `make test` inside Couch slots, whose shells export ~80 PAIR_*/COUCH_*/ZELLIJ*
# values, most of them paths to the session's own files; a test reading one
# fails spuriously or writes into the operator's session. The session's names
# are the ones production code mentions (any syntax: SetEnv, constants, KDL,
# shell), plus zellij's own ZELLIJ*. A name only tests read is a caller's knob
# and passes through, as do TEST_ENV_KNOBS, the families a production tool
# reads as an operator knob (doctor/perf.sh's PAIR_PERF_*). Only
# environment-origin names are dropped, and only when every goal is a test, so
# workflow targets (weave, merge, ...) keep the slot identity they may read.
# tests/make-test-env-test.sh derives every test-read and documented knob and
# proves each reaches a test recipe.
TEST_ENV_KNOBS := PAIR_TEST_% PAIR_LIVE_% PAIR_PERF_% PAIR_PROBE_% PAIR_NATIVE_% PAIR_ARTIFACT_% PAIR_COUCH_PRESSURE% PAIR_TERMINAL_ORACLE
PRODUCTION_ENV_NAMES_CMD := grep -rIhoE '\b(PAIR|COUCH)_[A-Z0-9_]+' cmd bin nvim zellij doctor --exclude='*_test.*' --exclude='*test*.sh' --exclude='*.md' --exclude-dir=testdata --exclude-dir=probes 2>/dev/null | sort -u
ifneq ($(MAKECMDGOALS),)
ifeq ($(filter-out test test-%,$(MAKECMDGOALS)),)
PRODUCTION_ENV_NAMES := $(shell $(PRODUCTION_ENV_NAMES_CMD))
SESSION_ENV := $(filter-out $(TEST_ENV_KNOBS),$(foreach v,$(.VARIABLES),$(if $(filter environment,$(origin $(v))),$(filter ZELLIJ% $(PRODUCTION_ENV_NAMES),$(v)))))
unexport $(SESSION_ENV)
endif
endif

.PHONY: build install pair runtimebundle-generate runtimebundle-drift-check test-runtimebundle test-clean-bootstrap test test-race test-nvim-pidfile test-run-headless test-lua test-lifecycle-command test-queue test-bang-tag test-autopair test-draft-complete test-pair-doctor test-perf-key-conformance test-plan-superseded test-paint-gate-consumers test-cr test-statusline test-doctor test-perf-capture test-adapt-schema test-dev-rebuild test-pair-go-install-layout test-pair-embedded-runtime test-pair-restart-quit test-pair-rename test-emitter-health test-session-watch test-changelog test-copy-on-select test-term-pane-shortcuts test-pair-title test-zellij-trace test-review

# Cross-cutting Go-binary targets. Every Go binary lives under cmd/<name>/
# and ships with the `pair-` prefix so it doesn't collide with anything
# else on PATH (pair-scribe replaced an earlier bare-named `scribe`).
#
# Adding a new binary: drop main.go under cmd/<name>/, append <name>
# to GO_BINS, add the per-binary recipe stanza. `make build` and
# `make install` pick it up automatically.
#
#   make build      → compile every binary in GO_BINS into ./bin/
#   make install    → link each into ~/.local/bin/ (checkout must remain)
#   make <name>     → build just that one (e.g., `make pair-scribe`)
#
# Why ./bin/ for the in-tree build: keeps Go output next to the shell
# scripts pair already ships from bin/, and pair-scrollback-open looks
# at $PAIR_HOME/bin/pair-scrollback-render to pick up the Go renderer
# in both dev (source tree) and brew-install layouts.
#
# Why ~/.local/bin/ for install: XDG convention, on PATH per the user's
# zshrc. Each binary the user wires into their shell (e.g. pair-scribe
# in zshrc) should reference $HOME/.local/bin/<name>.

BIN_DIR     := bin
INSTALL_DIR := $(HOME)/.local/bin
# Pair remains the single user-facing toolbox binary (#104). Couch's internal
# pre-exec helper is installed beside couch because it must exist as a separate
# blocked process before Pair can safely exec.
GO_BINS     := pair couch pair-launch-helper
# BUSYBOX_LINKS: pair invoked under one of these names routes to the matching
# subcommand (entrypoint busybox dispatch). Only pair-slug survives — the
# external Claude Stop hook may still call it by bare name. Emitted as symlinks
# → pair by BOTH `build` and `install`: `build` is load-bearing because pair-dev
# rebuilds via `make build` (not install) and the session PATH fronts the repo
# bin/, while `install` covers ~/.local/bin.
BUSYBOX_LINKS := pair-slug
SHELL_BINS  := pair-dev couch-dev
PAIR_HOME_LDFLAGS := -X main.defaultPairHome=$(CURDIR)
RUNTIMEBUNDLE_ASSETS := cmd/internal/runtimebundle/assets/runtime/manifest.json

# test-live — the opt-in conformance suites. A gated test nothing runs is not a
# pin, so the gate needs a target; PAIR_LIVE_COUCH compares couch's stateful
# fakes against real processes and real git.
# test-smoke — the committed probes. A probe whose result is quoted as close
# evidence has to be re-runnable by anyone, which means a target, not a
# remembered `go run` line (#146 M1 BR-16). Not in `test`: it drives a real
# terminal child and takes ~20s.
#
# It runs every directory under probes/ WITHOUT a list, which is the point --
# but "every directory" now includes probes/zellijprobe, the harness the probes
# share (#199 BR-52). `go run` on a library package fails, and with `|| exit 1`
# that aborted the whole suite, so the loop skips a directory with no `package
# main`. A skip, not an entry in a second list: the next shared package must not
# need remembering either.
.PHONY: test-smoke
test-smoke: $(BIN_DIR)/pair $(BIN_DIR)/pair-launch-helper
	@for p in probes/*/; do \
	    if ! grep -qs '^package main$$' $$p*.go; then \
	        echo "==> $$p (shared harness, not a probe)"; \
	        continue; \
	    fi; \
	    echo "==> $$p"; \
	    go run ./$$p || exit 1; \
	done

.PHONY: test-live test-native-session-live test-session-inventory-conformance
test-live: test-native-session-live
	# Real-process suites share OS-global signal/session resources; package-level
	# parallelism makes them interfere rather than exercise independent systems.
	PAIR_LIVE_COUCH=1 go test -p 1 ./cmd/... -count=1

test-native-session-live:
	PAIR_LIVE_NATIVE_SESSIONS=1 go test -p 20 ./cmd/internal/sessioninventory -run '^TestLiveNativeSessionShapeConformance$$' -count=1 -v

test-session-inventory-conformance:
	PAIR_LIVE_SESSION_INVENTORY=1 go test -p 20 ./cmd/internal/sessioninventory -run '^TestLiveIncrementalInventoryPrelaunch$$' -count=1 -v
	PAIR_LIVE_NATIVE_SESSIONS=1 go test -p 20 ./cmd/internal/sessioninventory -run '^TestLive(ProviderContractConformance|JSONLProviderBehaviorMatchesStatefulFake)$$' -count=1 -v

.PHONY: test-make-env test-make-env-probe test-make-env-production-names
# The session-env scrub keeps opt-in knobs and drops session identity (pair#436).
test-make-env:
	bash tests/make-test-env-test.sh
# Prints the recipe environment for test-make-env; a test goal, so it is scrubbed.
test-make-env-probe:
	@env
# The production-mentioned names the scrub is built from, for the check above.
test-make-env-production-names:
	@$(PRODUCTION_ENV_NAMES_CMD)

.PHONY: test-perf-budgets
# Wall-clock budgets (ARCH-CONSTRAINTS) flake on a loaded host, so the default
# lane runs their scenarios without asserting the clock (pair#436, pair#481;
# cmd/internal/perfbudget). Run on a quiet host. Each budget runs on its own.
test-perf-budgets: $(BIN_DIR)/pair
	PAIR_PERF_BUDGETS=1 sh doctor/perf_test.sh --budget-only
	PAIR_PERF_BUDGETS=1 go test ./cmd/internal/couchcore -run '^TestAcceptance(ObserveBudget|ReportBudgetTenSlots)$$' -count=1 -v
	PAIR_PERF_BUDGETS=1 go test ./cmd/internal/wrapcmd -run '^TestTailOverEndpointSocketIsFast$$' -count=1 -v

.PHONY: test-couch-zellij-live
# pair#432 excludes TestParkLifecycleLive, TestContinuationZellijSeedTransportLive
# and Recovery/checkpoint until it settles duplicate-quit idempotency and the
# cold-launch ownership poll. Restore them to -run and drop -skip there.
test-couch-zellij-live:
	PAIR_LIVE_COUCH=1 go test -p 20 ./cmd/internal/launcher -run '^(TestSessionQuiescenceLive|TestSessionDetachLive|TestQuitLifecycleLive|TestTheAcceptorAgreesWithRealZellijLive)$$' -count=1 -v
	PAIR_LIVE_COUCH=1 go test -p 20 ./cmd/internal/couchcore -run '^(TestParkLifecycleLiveIntentOnlyMutation|TestRecoveryRealHelperAndSessionConformanceLive)$$' -skip '^TestRecoveryRealHelperAndSessionConformanceLive$$/^checkpoint$$' -count=1 -v
	PAIR_LIVE_COUCH=1 go test -p 20 ./cmd/internal/couchcmd -run '^TestAgentShortcutInputConformanceLive$$' -count=1 -v

.PHONY: test-native-terminal-ci
# Strict gate: fresh temporary candidate, native dependencies, no skipped tests.
test-native-terminal-ci: runtimebundle-generate
	python3 tests/native-terminal-ci-test.py
	python3 tests/native-terminal-ci.py

.PHONY: test-perf-capture
# Shape tests for the #208 capture. perf.sh's VALUES are whatever the machine is
# doing, so this pins the report's shape -- which is what consumers parse and
# what the collector bugs corrupted.
test-perf-capture: $(BIN_DIR)/pair
	python3 doctor/perf_budget_test.py
	sh doctor/perf_test.sh

.PHONY: test-couch-start-recovery test-term-ctrlc test-term-rows test-couch-nested-rows test-zellij-repaint
test-term-ctrlc: $(BIN_DIR)/pair
	go run ./cmd/probes/termctrlc $(CURDIR)/$(BIN_DIR)/pair

# Two reserved rows, one above the other: couch holds the HOST terminal's bottom
# row and `pair term` holds its PANE's. Its own target rather than test-smoke
# because it starts a real zellij session and takes ~40s (#199 M3).
test-couch-nested-rows: $(BIN_DIR)/pair
	go run ./cmd/probes/couchnestedrows $(CURDIR)/$(BIN_DIR)/pair

test-term-rows: $(BIN_DIR)/pair
	go run ./cmd/probes/termrows $(CURDIR)/$(BIN_DIR)/pair

test-couch-start-recovery: $(BIN_DIR)/pair-launch-helper
	go run ./cmd/probes/couchstartrecovery $(CURDIR)/$(BIN_DIR)/pair-launch-helper

# Does zellij repaint a pane from its own buffer on SIGWINCH? #209's fix for the
# dominant failure mode rests on it. Its own target rather than test-smoke: it
# starts a real zellij session and takes ~40s, and it lives under cmd/probes/
# because it imports ptychild.RepaintSettle rather than restating the settle it
# is meant to verify (#209 C1 -- the default was 0 for one commit, which is the
# sequence the probe's own table measures at 6-of-12).
#
#   PAIR_PROBE_SETTLE=0s make test-zellij-repaint   # re-measure the table
test-zellij-repaint:
	go run ./cmd/probes/zellijrepaint

# What does reattaching a detached session cost, and what does couch's own
# zellij work around it cost -- before and after pair#228's narrowing? Its own
# target, not test-smoke: it creates N+1 real zellij sessions (sandbox off) and
# its numbers depend on host co-tenancy, which it prints first.
#
#   PAIR_PROBE_N=11 make test-reattach-cost
#   PAIR_PROBE_SAMPLE_SECS=30 make test-reattach-cost   # sample mode: zellij action latency only
test-reattach-cost:
	go run ./cmd/probes/reattachcost

build: $(addprefix $(BIN_DIR)/,$(GO_BINS)) $(addprefix $(BIN_DIR)/,$(BUSYBOX_LINKS))

install: build
	@mkdir -p "$(INSTALL_DIR)"
	@for b in $(GO_BINS); do \
	    ln -sf "$(CURDIR)/$(BIN_DIR)/$$b" "$(INSTALL_DIR)/$$b" && \
	    echo "linked: $(INSTALL_DIR)/$$b -> $(CURDIR)/$(BIN_DIR)/$$b"; \
	done
	@for l in $(BUSYBOX_LINKS); do \
	    ln -sf pair "$(INSTALL_DIR)/$$l" && \
	    echo "linked: $(INSTALL_DIR)/$$l -> pair"; \
	done
	@for b in $(SHELL_BINS); do \
	    ln -sf "$(CURDIR)/$(BIN_DIR)/$$b" "$(INSTALL_DIR)/$$b" && \
	    echo "linked: $(INSTALL_DIR)/$$b -> $(CURDIR)/$(BIN_DIR)/$$b"; \
	done

# `make pair` builds the single binary (the recipe below also emits the busybox
# symlinks, so `build`/`install`/`pair` all get them without a recipe on `build`,
# which would clash with the base layer's `build` target).
pair: $(BIN_DIR)/pair

# Tests
#   make test       → generate the ignored embed tree, then run every suite
#                     including go test ./... with its cache disabled.
#   make test-race  → race-detector run, scoped to packages where the
#                     suite has actual concurrent code worth checking.
#                     pair-wrap has translateStdin's goroutine + timer +
#                     channels; pair-scrollback-render's render() spawns
#                     a goroutine drainer that races with em.Close()
#                     inside the vt.Emulator library API itself, which is
#                     outside our scope to fix — exclude that package
#                     here rather than chase a library-level race.
# Each default non-Go recipe has exactly one affected group owner. Keep the
# ordinary full-suite list independent: test-affected-runner audits its union
# against these lists, so a newly added default recipe cannot silently drift.
PAIR_AFFECTED_LUA := test-lua test-retention test-nvim-pidfile test-lifecycle-command test-queue test-submission-transaction test-bang-tag test-autopair test-draft-complete test-pair-doctor test-cr test-statusline
PAIR_AFFECTED_REVIEW := test-review
PAIR_AFFECTED_DOCTOR := test-doctor test-perf-capture test-perf-key-conformance test-emitter-health test-adapt-schema
PAIR_AFFECTED_BUILD := test-build-go-atomic test-supervision-labels test-dev-rebuild test-pair-go-install-layout test-pair-embedded-runtime test-make-env test-host-preflight test-run-headless
PAIR_AFFECTED_SHELL := test-session-watch test-pair-restart-quit test-pair-rename test-changelog test-copy-on-select test-term-pane-shortcuts test-zellij-trace test-plan-superseded test-paint-gate-consumers

.PHONY: test-affected test-affected-lua test-affected-review test-affected-doctor test-affected-build test-affected-shell test-affected-runner test-affected-config
test-affected:
	python3 -B scripts/test-affected.py
test-affected-lua: $(PAIR_AFFECTED_LUA)
test-affected-review: $(PAIR_AFFECTED_REVIEW)
test-affected-doctor: $(PAIR_AFFECTED_DOCTOR)
test-affected-build: $(PAIR_AFFECTED_BUILD)
test-affected-shell: $(PAIR_AFFECTED_SHELL)
test-affected-runner:
	python3 -B tests/test-affected-test.py
	python3 -B tests/affected-go-readers-test.py
# Re-audit inputs before refreshing one certificate; never bless unrelated hashes.
.PHONY: affected-readers
affected-readers:
	$(if $(and $(READER),$(DISPOSITION)),,$(error use make affected-readers READER=<path> DISPOSITION=<audited-kind>))
	python3 -B tests/affected-go-readers-test.py --record "$(READER)" --disposition "$(DISPOSITION)"

.PHONY: test-affected-inventory
test-affected-inventory:
	python3 -B tests/affected-go-readers-test.py --check
test-affected-config:
	python3 -B tests/affected-config-test.py

ifeq ($(PAIR_TEST_BINARY),)
test:
	bash tests/lib/with-pair-test-binary.sh $(MAKE) test
else
test: test-affected-runner test-affected-config test-build-go-atomic test-supervision-labels test-host-preflight runtimebundle-generate test-retention test-nvim-pidfile test-run-headless test-lua test-lifecycle-command test-perf-capture test-queue test-submission-transaction test-bang-tag test-autopair test-draft-complete test-pair-doctor test-perf-key-conformance test-plan-superseded test-paint-gate-consumers test-cr test-statusline test-doctor test-adapt-schema test-dev-rebuild test-pair-go-install-layout test-pair-embedded-runtime test-pair-restart-quit test-pair-rename test-emitter-health test-session-watch test-changelog test-copy-on-select test-term-pane-shortcuts test-pair-title test-zellij-trace test-review test-make-env
	# pair#610: temporary 20m per-package budget; couchcore is ~580s idle.
	# pair#611 profiles/splits/shards it before removing this allowance.
	go test ./... -count=1 -timeout 20m
endif

# First prerequisite of test (pair#450): an agent sandbox refuses unix sockets,
# PTYs and exec of ps, and the suite then fails in ~150 places that read like
# code bugs. Plain `make test` stops here; `make -k test` prints this first and
# still runs the rest, so read its first failure before the others.
.PHONY: test-host-preflight
test-host-preflight:
	bash tests/host-preflight.sh

# Expensive, explicit boundary regression: prove make test from a no-.git
# archive with the ignored runtime mirror absent. Kept out of test to avoid a
# recursive full-suite child.
test-clean-bootstrap:
	bash tests/clean-bootstrap-test.sh

# pair-title poller (#93 M1, now Go): single-instance guard (identity-checked
# liveness so a recycled PID can't suppress the respawn) + the #71 frame meter
# (renames each agent pane to "<agent> (<count>)", with unchanged-skip)
# + the cmux heat-ramp. The old shell harness (PAIR_TITLE_TEST_CALL hook) retired
# with the port; its coverage moved to Go unit tests over the Runtime seam.
test-pair-title:
	go test ./cmd/internal/titlepoller ./cmd/internal/procutil -count=1

# Session id watcher must ignore stale pidfiles from prior launches and wait
# for pair-wrap to publish the current agent PID.
test-session-watch: $(BIN_DIR)/pair
	bash tests/pair-session-watch-test.sh

# The bundle carries config + shell shims only (#104 M3) — no helper binaries to
# build first, so no prereq.
runtimebundle-generate:
	go run ./cmd/internal/runtimebundle/generatecmd --repo . --out cmd/internal/runtimebundle/assets/runtime

$(RUNTIMEBUNDLE_ASSETS): runtimebundle-generate

runtimebundle-drift-check:
	@d1="$$(mktemp -d)"; d2="$$(mktemp -d)"; \
	trap 'rm -rf "$$d1" "$$d2"' EXIT; \
	go run ./cmd/internal/runtimebundle/generatecmd --repo . --out "$$d1/runtime" && \
	go run ./cmd/internal/runtimebundle/generatecmd --repo . --out "$$d2/runtime" && \
	diff -qr "$$d1/runtime" "$$d2/runtime" >/dev/null && \
	find "$$d1/runtime/files" -type f -exec stat -f '%N %OLp' {} + | sed "s#$$d1/runtime/files/##" | sort > "$$d1/modes" && \
	find "$$d2/runtime/files" -type f -exec stat -f '%N %OLp' {} + | sed "s#$$d2/runtime/files/##" | sort > "$$d2/modes" && \
	diff -u "$$d1/modes" "$$d2/modes" >/dev/null

test-runtimebundle: runtimebundle-generate
	go test ./cmd/internal/runtimebundle -count=1

# Review workbench (#66): the integration shell tests. The pure modules
# (record, reconstruct) run under `make test-lua`.
# The review helpers are now built Go binaries (#93 M3), not committed shell
# scripts — declare them as prereqs so a fresh-tree `make test` builds them
# before the review suite execs `$ROOT/bin/pair-review-*`.
test-review: $(BIN_DIR)/pair
	bash tests/review-docflow-test.sh
	bash tests/review-apply-test.sh
	bash tests/review-applied-round-test.sh
	bash tests/review-projection-test.sh
	bash tests/review-poke-test.sh
	bash tests/review-window-test.sh
	bash tests/review-controls-test.sh
	bash tests/review-comments-test.sh
	bash tests/overlay-return-test.sh
	bash tests/review-toggle-test.sh
	bash tests/pair-review-target-test.sh
	bash tests/review-readiness-cli-test.sh
	bash tests/review-indicator-test.sh
	bash tests/review-resume-test.sh
	python3 -B tests/review-resume-isolation-test.py
	bash tests/review-definition-test.sh
	bash tests/review-branch-restore-test.sh
	python3 -B tests/review-observation-diagnostics-test.py
	bash tests/review-observation-test.sh
	python3 -B tests/review-fresh-restore-diagnostics-test.py
	bash tests/review-fresh-restore-test.sh

# Whole tree, not one package: the pumps and the switcher span packages, and
# ./cmd/pair-wrap/ has not existed since the Go entrypoint switch -- the target
# failed outright with "directory not found" until #146 M1's boundary review
# noticed the -race half of the test-live rule had no runnable target.
test-race:
	go test -count=1 -race ./cmd/...

# Self-test for the headless-nvim timeout watchdog (tests/lib/run-headless.sh,
# #60). Runs FIRST in `test` so the safety net every headless-nvim sub-target
# now relies on is proven before those targets run — without it, a driver that
# fails to quit (bare `qall` on a modified buffer → E37) hangs the whole suite.
test-run-headless:
	bash tests/run-headless-test.sh

# Headless Lua tests for nvim/*.lua decision modules (issue #000027). nvim -l
# runs a Lua script in nvim's interpreter with the full vim.api available, so
# pure logic AND buffer-manipulation can be asserted without a UI.
test-lua:
	nvim -l tests/zellij-observation_test.lua
	nvim -l tests/review-restore-admission-test.lua
	bash tests/nvim-route-poke-admission-test.sh
	nvim -l nvim/dom_transport_test.lua
	nvim -l nvim/dom_admission_test.lua
	nvim -l nvim/dom_admission_cli_test.lua
	nvim -l nvim/fs_watch_test.lua
	nvim -l nvim/retention_test.lua
	nvim -l nvim/confirm_quit_test.lua
	nvim -l nvim/lifecycle_command_test.lua
	nvim -l nvim/workbench_route_test.lua
	bash tests/workbench-route-nvim-test.sh
	nvim -l nvim/slug_test.lua
	nvim -l nvim/normalization_test.lua
	nvim -l nvim/submission_test.lua
	nvim -l nvim/draft_send_test.lua
	nvim -l nvim/interrupt_test.lua
	nvim -l nvim/bang_tag_test.lua
	nvim -l nvim/pairlog_test.lua
	nvim -l nvim/scrollback_test.lua
	nvim -l nvim/annotate_test.lua
	nvim -l nvim/changelog_test.lua
	python3 -B tests/changelog-isolation-test.py
	nvim -l nvim/adapt_test.lua
	nvim -l nvim/doctor_test.lua
	nvim -l nvim/review/record_test.lua
	nvim -l nvim/review/reconstruct_test.lua
	nvim -l nvim/review/resolve_fixtures_test.lua
	nvim -l nvim/review/round_watch_test.lua
	nvim -l nvim/review/define_test.lua
	nvim -l nvim/review/markers_test.lua
	nvim -l nvim/review/comment_codec_test.lua
	nvim -l nvim/review/comment_thread_test.lua
	nvim -l nvim/review/comment_view_test.lua
	nvim -l nvim/review/comment_float_test.lua
	nvim -l nvim/review/comment_test.lua
	nvim -l nvim/review/seam_test.lua
	nvim -l nvim/review/mode_test.lua
	nvim -l nvim/review/poke_bodies_test.lua
	nvim -l nvim/review/wrap_test.lua
	nvim -l nvim/review/readiness_test.lua
	nvim -l nvim/review/spinner_test.lua
	nvim -l nvim/review/resolve_test.lua
	nvim -l nvim/review/menu_test.lua
	nvim -l nvim/review/restore_test.lua
	nvim -l nvim/review/identity_test.lua
	nvim -l nvim/review/restore_client_test.lua
	nvim -l nvim/review/restore_controller_test.lua
	nvim -l nvim/review/document_bytes_test.lua
	nvim -l nvim/review/recovery_test.lua
	nvim -l nvim/review/recovery_observer_test.lua
	nvim -l nvim/review/definition_seam_test.lua
	nvim -l nvim/review/round_authority_test.lua
	nvim -l nvim/review/agent_round_rule_test.lua

# Integration test for nvim/init.lua's send/queue/history state machine.
# Drives the real init.lua under headless nvim (it can't be unit-tested —
# monolithic config, all-local fns). Guards the send-from-queue duplication
# regression. See tests/queue-send-test.sh.
test-queue:
	bash tests/queue-send-test.sh

test-submission-transaction:
	bash tests/submission-transaction-nvim-test.sh

# #337: `!` draft lines strip the bang and publish the couch description.
test-bang-tag:
	bash tests/bang-tag-nvim-test.sh

# The four confirmed lifecycle keybinds route through the shared reporting
# helper (#284). See tests/lifecycle-command-nvim-test.sh.
test-lifecycle-command:
	bash tests/lifecycle-command-nvim-test.sh

# Diagnostic trace for pair-originated zellij action calls (#68).
test-zellij-trace:
	bash tests/zellij-trace-test.sh

# Regression test for the autopair next-char gate (nvim/init.lua,
# pair_insert_open). Drives the real init.lua headlessly and asserts each
# opener's expr output. See tests/autopair-test.sh.
test-autopair:
	bash tests/autopair-test.sh

# Regression test for the draft typeahead completer mode guard (nvim/init.lua,
# run_completers). Drives the real init.lua headlessly and asserts the shared
# runner no-ops outside Insert mode before any vim.fn.complete() call can raise
# E785. See tests/draft-complete-mode-test.sh.
test-draft-complete:
	bash tests/draft-complete-mode-test.sh

# Regression test for the :PairDoctor wiring (#208). Drives the real init.lua
# headlessly with an injected capture runner, because both defects that shipped
# in M2 lived in the glue between doctor.lua and init.lua -- which the pure
# suite does not execute. See tests/pair-doctor-test.sh.
test-pair-doctor:
	bash tests/pair-doctor-test.sh

# Conformance between doctor.lua's key declaration and what perf.sh actually
# emits. perf.sh is shell and cannot import the Lua table, so its restatement
# needs a test or a producer rename drops rows from the prompt silently. See
# tests/perf-key-conformance-test.sh.
test-perf-key-conformance:
	bash tests/perf-key-conformance-test.sh

# A plan must not keep asserting a fact its own Revisions says was superseded.
# pair#199 wrote that rule and then failed its own acceptance grep three rounds
# running, each time recording "All swept." A sweep that depends on remembering
# to sweep is the defect it was meant to fix. See tests/plan-superseded-facts-test.sh.
test-plan-superseded:
	bash tests/plan-superseded-facts-test.sh

test-paint-gate-consumers:
	bash tests/paint-gate-consumers-test.sh

# Regression test for the insert-mode <CR> decision (nvim/init.lua, cr_keys /
# _G.PairCRKeys, #65): Return must always insert a newline when no completion
# is selected, dismissing the popup. Asserts the expr output for all three
# popup states. See tests/cr-newline-test.sh.
test-cr:
	bash tests/cr-newline-test.sh

# Regression tests for the draft statusline (nvim/init.lua, _G.PairStatusline).
# Drive the real init.lua headlessly: statusline-pos asserts the *, -N, +N nav
# marker; changelog-notify asserts the ephemeral "change log ready" flash + its
# fs_event marker watcher (#58).
test-statusline:
	bash tests/statusline-pos-test.sh
	bash tests/changelog-notify-test.sh

# Regression test for doctor/doctor.sh (the adaptation flight-recorder reader):
# a malformed line must not abort the diagnostic. See doctor/doctor_test.sh.
test-doctor:
	bash doctor/doctor_test.sh

# copy-on-select in_nvim detection: the agent overwrites its pane title with
# "claude [<cwd>]", so a repo path containing "nvim" (e.g. parley.nvim) must not
# be mistaken for the nvim draft pane (which would skip the paste). Keys on
# terminal_command, not the cwd-polluted title. See tests/copy-on-select-test.sh.
# Since #125 the script also pins the right-terminal gate (see its header).
# copy-on-select is the Go binary (#93 M4; zellij's copy_command invokes it
# directly since #94 M2), so a fresh-tree run must build it before the test copies
# it into the sandboxed $PAIR_HOME/bin (same missing-prereq lesson as M2/M3).
test-copy-on-select: $(BIN_DIR)/pair
	bash tests/copy-on-select-test.sh

test-term-pane-shortcuts: $(BIN_DIR)/pair
	bash tests/term-pane-shortcuts-test.sh

# Cross-emitter contract for the flight recorder: Go == shell == Lua schema,
# plus concurrent-append line-atomicity. See tests/adapt-schema-test.sh.
test-adapt-schema:
	bash tests/adapt-schema-test.sh

# pair-dev / couch-dev rebuild hook (#000046, #422): deployed mode (PAIR_DEV unset) must invoke
# no toolchain; dev mode builds; build failure is errexit-safe. See
# tests/dev-rebuild-test.sh.
test-dev-rebuild:
	bash tests/dev-rebuild-test.sh

# Local install links follow checkout rebuilds; copied-binary runtime support
# is covered separately by test-pair-embedded-runtime.
test-pair-go-install-layout:
	bash tests/pair-go-install-layout-test.sh

test-pair-embedded-runtime: test-without-ancestors
	bash tests/pair-embedded-runtime-test.sh

# pair restart/quit Go subcommands (#94 M1, ported from bin/pair-{restart,quit}.sh):
# markers land in ~/.cache/pair with PAIR_KILL_CMD stubbing the terminal kill.
test-pair-restart-quit: $(BIN_DIR)/pair
	bash tests/pair-restart-quit-test.sh

# pair-doctor emitter-health probe (#000047): marker check + binary selection
# (running-via-pidfile vs PATH). See tests/emitter-health-test.sh.
test-emitter-health:
	bash tests/emitter-health-test.sh

# changelog + scrollback openers — end-to-end smokes for the #93 M2 Go binaries
# (bin/pair-changelog-open, bin/pair-scrollback-open): fake the scrollback capture
# + model + nvim and assert clean → distill → write → open (changelog) and render
# → open (scrollback). Depend on the binaries so `make test` builds + runs them
# (the scripts SKIP if absent, which would silently no-op in CI without these).
test-changelog: $(BIN_DIR)/pair
	sh tests/changelog-open-test.sh
	sh tests/changelog-session-key-test.sh
	sh tests/scrollback-open-test.sh

# All former helper binaries are gone (#104 M3) — each is a `pair <subcommand>`
# built into the single `pair` below. Their logic still lives in cmd/internal/*.

# Staleness hint for the pair recipe (NOT the compile set — `go build` pulls
# every dep). A find over cmd/ and internal/ avoids the drift the old hand-maintained list
# risked; the runtime assets are a prereq so a bundle change rebuilds pair too.
PAIR_GO_SRCS := scripts/build-go-atomic.sh $(shell find cmd internal -name '*.go' -not -name '*_test.go' 2>/dev/null) Makefile.local go.mod $(RUNTIMEBUNDLE_ASSETS) cmd/pair-go/main.go cmd/internal/entrypoint/asset_root.go cmd/internal/entrypoint/mode.go cmd/internal/dispatcher/dispatcher.go cmd/internal/launcher/args.go cmd/internal/launcher/datadir.go cmd/internal/launcher/decision.go cmd/internal/launcher/history.go cmd/internal/launcher/run.go cmd/internal/launcher/session.go cmd/internal/launcher/tag.go cmd/internal/launcher/zellij.go cmd/internal/contextcmd/contextcmd.go cmd/internal/scrollbackcmd/scrollbackcmd.go cmd/internal/slugcmd/slugcmd.go cmd/internal/slugcmd/slug.go cmd/internal/wrapcmd/wrap.go cmd/internal/scribecmd/scribecmd.go cmd/internal/changelogcmd/changelogcmd.go cmd/internal/changelogcmd/distill.go cmd/internal/changelogcmd/prompt.go cmd/internal/continuationcmd/continuationcmd.go cmd/internal/continuationcmd/continuation.go cmd/internal/continuationcmd/git.go cmd/internal/sessionwatch/sessionwatch.go cmd/internal/sessionwatch/run.go cmd/internal/sessionwatch/runcli.go cmd/internal/sessionwatch/runtime.go cmd/internal/procutil/procutil.go cmd/internal/model/model.go cmd/internal/adapt/adapt.go cmd/internal/runtimebundle/manifest.go cmd/internal/runtimebundle/plan.go cmd/internal/runtimebundle/cleanup.go cmd/internal/runtimebundle/store.go cmd/internal/runtimebundle/embed.go $(RUNTIMEBUNDLE_ASSETS) go.mod

# pair — the Go-owned entrypoint. It drives the native launcher in-process (#99
# M5c — bin/pair-shell retired); source/Homebrew builds can inject defaultPairHome,
# while copied binaries without adjacent assets use the embedded runtime fallback.
# (PAIR_GO_SRCS is a staleness hint, not the compile set — `go build` pulls every
# dep; it needn't list every cmd/internal/launcher file.)
$(BIN_DIR)/pair: $(PAIR_GO_SRCS)
	bash scripts/build-go-atomic.sh "$@" -ldflags "$(PAIR_HOME_LDFLAGS)" ./cmd/pair-go

# couch — the supervisor binary (#145). Deliberately separate from pair: pair is
# what the operator sits inside, so a couch bug must not break the ability to
# fix it, and the fallback is always to launch pair the old way. No
# PAIR_HOME_LDFLAGS -- couch resolves nothing from an asset root.
$(BIN_DIR)/couch: $(PAIR_GO_SRCS)
	bash scripts/build-go-atomic.sh "$@" ./cmd/couch

$(BIN_DIR)/pair-launch-helper: $(PAIR_GO_SRCS)
	bash scripts/build-go-atomic.sh "$@" ./cmd/pair-launch-helper

# Busybox symlinks (pair-slug → pair): a real target each, so `build` restores a
# deleted symlink even when bin/pair is already up-to-date (not only when the pair
# recipe fires). `install` re-links them into $(INSTALL_DIR) separately.
$(addprefix $(BIN_DIR)/,$(BUSYBOX_LINKS)): $(BIN_DIR)/pair
	@ln -sf pair $@


# Tart VM targets (tart, tart-gui, tart-mount, tart-stop, tart-clean)
# live in .tart/Makefile, vendored from ariadne and auto-included by
# Makefile.workflow. `make help-tart` for usage.

.PHONY: test-retention
test-retention:
	bash tests/retention-test.sh
# The nvim pid sidecar's lifecycle (#583): published at startup, removed on a clean
# exit, kept on a SIGKILL, and never removed when a later embed republished it.
# Covers all four publishing configs — see the script header for why the rule is
# spelled per config.
.PHONY: test-nvim-pidfile
test-nvim-pidfile:
	bash tests/nvim-pidfile-lifecycle-test.sh
.PHONY: test-couch-recovery-smoke
test-couch-recovery-smoke:
	sh tests/couch-recovery-smoke.sh $(MODE)

.PHONY: test-supervision-labels
test-supervision-labels:
	python3 -m unittest discover -s scripts/supervision-labels

.PHONY: test-without-ancestors
test-without-ancestors:
	python3 tests/without-ancestors-test.py

# Run after changing the drive/parser/writer or upgrading Codex, before landing.
# Both native suites use disposable configuration; no peer slot is driven.
.PHONY: test-agent-drive-live
test-agent-drive-live:
	PAIR_LIVE_AGENT_DRIVE=codex PAIR_LIVE_AGENT_DRIVE_VIRTUAL=codex go test ./cmd/internal/wrapcmd -run '^TestAgentDrive(LiveConformance|VirtualTerminalLiveConformance)$$' -count=1 -v

.PHONY: test-build-go-atomic
test-build-go-atomic:
	python3 -B tests/build-go-atomic-test.py

# Offline rename matrix uses the same private candidate as the full suite.
test-pair-rename:
	bash tests/pair-rename.sh

.PHONY: zellij-false-miss
zellij-false-miss:
	python3 -B tests/zellij-false-miss-test.py
	bash scripts/repro/zellij-false-miss.sh
