.constitution-check-state
.antigravitycli/
.goto
.openshell/.bootstrap/
.openshell/.base-image-digest
__pycache__/
.DS_Store
# bin/ holds BOTH built Go binaries (Makefile.local GO_BINS) AND pair's own
# SHELL launcher scripts. The binaries are build output (ignored); the shell
# scripts are SOURCE and stay tracked. Blanket-ignore is the safe default — a
# newly built binary is never committed by accident — and the negations below
# re-include the scripts by name/glob. (Restored after a 2026-06-16
# propagate-base sweep git-rm'd these tracked scripts: the blanket bin/ ignore
# made them look disposable. See workshop/issues #64.)
bin/*
!bin/*.sh
!bin/pair-dev
!bin/pair-help
!bin/pair-notify
!bin/lib/
bin/lib/*
!bin/lib/*.sh
cache/

# superpowers brainstorming previews and server lifecycle markers
.superpowers/

/AGENTS.md
/.claude/skills/
/.claude/settings.json
/.colima/
/construct/scripts/vm-log.sh
/CLAUDE.md
/GEMINI.md
/.agents/skills/
/construct/generated/
/cmd/internal/runtimebundle/assets/

# Go writes `go build ./cmd/foo` output into the CURRENT directory, so a stray
# build from the repo root drops a multi-megabyte binary next to the source --
# and `git add -A` sweeps it in. Happened once (pair#170 M4 committed a 4.5 MB
# couchstartrecovery), and this repo is the ariadne base layer, so such a blob
# propagates to every dependent repo and is permanent once merged.
#
# Root-anchored and named after the main packages, so it cannot shadow a real
# source directory the way a bare `couch` pattern would. Kept in step with the
# tree by TestEveryMainPackageIsIgnoredAtTheRepoRoot -- the first hand-written
# version of this list already missed two entries the day it was added.
/couch
/pair-go
/pair-launch-helper
/couchstartrecovery
/generatecmd
/termsmoke
/zellijpark
