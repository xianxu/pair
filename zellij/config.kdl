// pair zellij config — adds two custom binds on top of zellij's defaults.
// Loaded via `zellij --config-dir <pair>/zellij`.

// pair uses zellij like a library — keep its own UI quiet.
// - Disable hover help-text tooltips on pane frames.
// - Disable advanced mouse actions (pane grouping, etc.) to keep mouse
//   behavior predictable for selection and our copy_command flow.
// - Mouse support itself stays ON. `mouse_mode false` (tried for #123 to
//   freeze pane drag/resize) also kills click-to-focus, text selection, the
//   copy_command clipboard mirror, and scroll — and click-to-focus is the last-resort
//   escape when keyboard focus lands somewhere unexpected. Split terminal
//   panes stay pinned. They are BORDERLESS since pair#199 M4 -- `pair term`
//   draws its own strip in a reserved row, which carries the tab title the
//   frame used to and doubles as the divider between split halves, each half
//   drawing its own. Drag-immunity comes from the tiled pivot (#123), not from
//   the frame, so removing it costs nothing there.
// - Suppress "what's new" release-notes popup on version bumps.
// - Enable pane frames globally so the AGENT pane shows zellij's
//   scroll-position indicator (top-right) when scrolled — the only way
//   to surface scrollback position, since zellij doesn't expose pane
//   scroll offset to plugins or the CLI. Cost on that pane: ~2 rows + 2
//   cols of frame chrome.
//
//   TWO panes opt out via `borderless=true`, for different reasons:
//   the DRAFT pane, so the "minimized" layout rung can collapse to 1 row
//   (framed minimum is ~3 rows); and, since pair#199 M4, the RIGHT
//   TERMINAL in main-3.kdl at all nine of its rungs, because `pair term`
//   now draws its own tab strip in a row it reserves for itself. The
//   frame's title was that pane's only label; the strip replaces it, and
//   says more (every tab, which one is active, the live rename field).
//   So "frames are global for the scroll indicator" is true of the agent
//   pane only — it was never true of the draft, and it stopped being true
//   of the terminal.
mouse_hover_effects false
advanced_mouse_actions false
focus_follows_mouse false
// Pair notifications travel through Zellij's single host-output owner.
host_notification_protocol "osc9"
support_kitty_keyboard_protocol true
show_release_notes false
show_startup_tips false
pane_frames true
// FULL frames, stated rather than defaulted (pair#223). zellij 0.45 split
// `pane_frames true` into a style and changed the default to "titles" — a
// title row above each pane and no border (zellij#5318). pair's layout was
// built on the full frame: the agent pane's top border IS its first line, and
// the scroll indicator above lives there. On 0.45 without this the operator
// saw the first line vanish. Measured: in a 30x100 session a pane is 29x49
// under "titles" and 28x48 under "full" — the full frame 0.44.3 drew.
//
// Harmless on 0.44.x, which predates the key: it looks options up by name and
// never rejects an unknown one (`zellij setup --check` on 0.44.3 and 0.45.1
// both report the file well defined). pair wants 0.45+ anyway — it is the
// release that stops a wrapped line escaping `pair term`'s scroll region.
pane_frame_style "full"

// Cap zellij's per-pane scroll-back at 2000 rows. Matches the
// pair-scrollback-render historyRows cap so PageUp inside the agent
// pane and Alt+/ both reach back the same distance. Default is 10000;
// 2000 keeps memory pressure modest on long-running sessions while
// still preserving enough history for "scroll up to find that thing
// the agent said a few turns ago" without dropping into Alt+/.
scroll_buffer_size 2000

// When clicking an unfocused pane, send the click into the pane (so a
// click-and-drag starts selecting text in one motion) rather than only
// changing focus and swallowing the click.
mouse_click_through true

// On selection finalize (mouse up), pipe the selected text to our wrapper.
// The wrapper mirrors it to the OS clipboard AND, for a selection made in the
// AGENT pane, hands off to the draft: reflow, >-prefix, focus nvim, insert at
// cursor. Since #125 a selection in the RIGHT TERMINAL only mirrors — copying a
// path there is usually just a copy, and the hand-off hijacked the draft.
// Selections in the draft itself are skipped (they would insert beneath
// themselves). (An older comment here credited "the Alt+n flow"; Alt+n is
// PairConfirmRestart and never triggered this.)
//
// the launcher prepends $PAIR_HOME/bin to PATH (RunLaunch, restored #95) so the
// binary is resolvable by bare name — avoids the fragile `sh -c '$PAIR_HOME/...'`
// quoting dance.
copy_command "pair clip copy-on-select"

// The receiving pane owns input. Disable inherited multiplexer control keys
// (resize, swap layout, floating panes, groups) so they cannot consume agent keys.
// Pair-owned shortcuts are forwarded; pane-local policy chooses their action.
keybinds clear-defaults=true {
    shared {
        bind "Alt j" { Write 27; Write 106; }
        bind "Alt k" { Write 27; Write 107; }
        bind "Alt t" { Write 27; Write 116; }
        bind "Alt w" { Write 27; Write 119; }
        bind "Alt r" { Write 27; Write 114; }
        bind "Alt x" { WriteChars "\u{1b}[120;3u"; }
        bind "Alt /" { Write 27; Write 47; }
        bind "Alt D" { WriteChars "\u{1b}[68;4u"; }
        bind "Alt T" { WriteChars "\u{1b}[84;4u"; }
        bind "Alt C" { Write 27; Write 67; }
        bind "Ctrl Alt c" { WriteChars "\u{1b}[99;7u"; }
        bind "Alt Shift Enter" { WriteChars "\u{1b}[13;4u"; }
        bind "Alt d" { WriteChars "\u{1b}[100;3u"; }
        bind "Alt Up" { WriteChars "\u{1b}[1;3A"; }
        bind "Alt Down" { WriteChars "\u{1b}[1;3B"; }
        bind "Alt c" { WriteChars "\u{1b}[99;3u"; }
        bind "Alt n" { WriteChars "\u{1b}[110;3u"; }
        bind "Ctrl Alt n" { WriteChars "\u{1b}[110;7u"; }
        bind "Alt N" { WriteChars "\u{1b}[78;4u"; }
        bind "Alt h" { WriteChars "\u{1b}[104;3u"; }
        bind "Alt l" { WriteChars "\u{1b}[108;3u"; }
    }
}
