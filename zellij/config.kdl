// pair zellij config — adds two custom binds on top of zellij's defaults.
// Loaded via `zellij --config-dir <pair>/zellij`.

// pair uses zellij like a library — keep its own UI quiet.
// - Disable hover help-text tooltips on pane frames.
// - Disable advanced mouse actions (pane grouping, etc.) to keep mouse
//   behavior predictable for selection and our copy_command flow.
// - Suppress "what's new" release-notes popup on version bumps.
// - Enable pane frames globally so the agent pane shows zellij's
//   scroll-position indicator (top-right) when scrolled — the only way
//   to surface scrollback position, since zellij doesn't expose pane
//   scroll offset to plugins or the CLI. The draft pane opts out via
//   `borderless=true` in both zellij/layouts/main-{2,3}.kdl so the "minimized"
//   layout rung can still collapse to 1 row (framed minimum is ~3
//   rows). Cost on the agent pane: ~2 rows + 2 cols of frame chrome.
mouse_hover_effects false
advanced_mouse_actions false
focus_follows_mouse true
show_release_notes false
show_startup_tips false
pane_frames true

// Cap zellij's per-pane scroll-back at 2000 rows. Matches the
// pair-scrollback-render historyRows cap so PageUp inside the agent
// pane and Alt+/ both reach back the same distance. Default is 10000;
// 2000 keeps memory pressure modest on long-running sessions while
// still preserving enough history for "scroll up to find that thing
// the agent said a few turns ago" without dropping into Alt+/.
scroll_buffer_size 2000

// When clicking an unfocused pane, send the click into the pane (so a
// click-and-drag starts selecting text in one motion) rather than only
// changing focus and swallowing the click.
mouse_click_through true

// On selection finalize (mouse up), pipe the selected text to our wrapper.
// The wrapper mirrors to the OS clipboard AND, if the selection was in a
// pane other than the nvim draft, runs the Alt+n flow: reflow, >-prefix,
// focus nvim, insert at cursor.
//
// the launcher prepends $PAIR_HOME/bin to PATH (RunLaunch, restored #95) so the
// binary is resolvable by bare name — avoids the fragile `sh -c '$PAIR_HOME/...'`
// quoting dance.
copy_command "pair clip copy-on-select"

keybinds clear-defaults=false {
    // Release Alt+i so nvim sees it (zellij's default binds Alt+i to MoveTab
    // "Left"; we want Alt+i to mean "attach image" inside the nvim draft).
    // Same logic for any other Alt-letter key we want to pass through.
    //
    // Alt+Left / Alt+Right are zellij's default MoveFocus bindings; we use
    // them in nvim for the prompt-history navigation (issue #000015), and
    // pair's two-pane layout doesn't need pane-focus arrows anyway —
    // Alt+Up / Alt+Down (rebound below to step the layout ladder) cover
    // the only useful agent ↔ draft size change.
    shared {
        unbind "Alt i"
        unbind "Alt Left"
        unbind "Alt Right"
        // Alt Up / Alt Down default to MoveFocus; pair only has two panes
        // (agent ↔ draft) so focus-shift is redundant. Reclaim them as
        // step-up / step-down through the layout sizes (minimized/1-3/2-3).
        unbind "Alt Up"
        unbind "Alt Down"
        // Alt+n default is NewPane; Alt+o default is MoveTab "Right". pair
        // manages its own two-pane/single-tab layout, so both are disabled or
        // reclaimed by pair-specific flows.
        unbind "Alt n"
        unbind "Alt N"
        unbind "Alt o"
        // Workbench-local keys are handled by the focused pane process:
        // pair wrap (agent), nvim/init.lua (draft), or pair term (right shell).
        unbind "Alt j"
        unbind "Alt k"
        unbind "Alt t"
        unbind "Alt w"
        unbind "Alt r"
        unbind "Alt x"
        unbind "Alt /"
        unbind "Alt C"
        unbind "Ctrl Alt c"
        unbind "Alt Shift Enter"
    }

    shared_except "locked" {
        // Workbench-local shortcuts are forwarded as ordinary Meta bytes to
        // the focused pane process. pair wrap, nvim/init.lua, pair term, and
        // nvim/review.lua then decide locally what the chord means.
        unbind "Alt j"
        unbind "Alt k"
        unbind "Alt t"
        unbind "Alt w"
        unbind "Alt r"
        unbind "Alt x"
        unbind "Alt /"
        unbind "Alt C"
        unbind "Ctrl Alt c"
        bind "Alt j" { Write 27; Write 106; }
        bind "Alt k" { Write 27; Write 107; }
        bind "Alt t" { Write 27; Write 116; }
        bind "Alt w" { Write 27; Write 119; }
        bind "Alt r" { Write 27; Write 114; }
        bind "Alt x" { WriteChars "\u{1b}[120;3u"; }
        bind "Alt /" { Write 27; Write 47; }
        bind "Alt C" { Write 27; Write 67; }
        bind "Ctrl Alt c" { WriteChars "\u{1b}[99;7u"; }
        bind "Alt Shift Enter" { WriteChars "\u{1b}[13;4u"; }

        // Disable Ctrl+q — zellij's default Quit leaves the session in the
        // resurrect list with dead processes inside, which is a confusing
        // half-state for pair's "long-lived agent session" model. Alt+x is
        // the only quit path; it tears down cleanly via `pair quit`.
        unbind "Ctrl q"

        // Lock pair into Normal mode. pair uses zellij as a pane manager,
        // never as a multi-mode TUI, so every default Ctrl-chord that
        // switches into another mode is pure surface area for mis-fires
        // (Ctrl+g in particular sits next to common editor chords). With
        // every mode-switch chord unbound, zellij can't leave Normal —
        // recovery from a bad binding is to edit this file, no in-session
        // escape hatch needed.
        unbind "Ctrl g"
        unbind "Ctrl p"
        unbind "Ctrl t"
        unbind "Ctrl n"
        unbind "Ctrl h"
        unbind "Ctrl s"
        unbind "Ctrl o"
        unbind "Ctrl b"

        // Draft-routed globals are forwarded to the focused process as
        // distinctive sequences. pair wrap, pair term, and every Pair-owned
        // nvim surface resolve the draft by pane id and invoke the action
        // there, without changing focus or depending on split topology.
        bind "Alt d" { WriteChars "\u{1b}[100;3u"; }

        // Alt+Up / Alt+Down — step the nvim draft pane along a three-rung
        // ladder: minimized (statusline only, cursor hidden) ↔ 12 lines
        // (initial) ↔ 1/2. Up steps toward bigger nvim, Down toward smaller;
        // each is clamped at the end of the ladder.
        bind "Alt Up" { WriteChars "\u{1b}[1;3A"; }
        bind "Alt Down" { WriteChars "\u{1b}[1;3B"; }

        // Alt+h — pop up a large floating pane with `pair -h` in a pager.
        // pair-help wraps `less` with a custom keymap so ESC (in addition to
        // the usual `q`) dismisses it; close_on_exit closes the pane when
        // the pager exits.
        bind "Alt h" {
            Run "pair-help" {
                floating true
                close_on_exit true
                name "pair help"
                width "100%"
                height "70%"
                x "0"
                y "15%"
            };
        }

        // Alt+c — collaboration/review workbench toggle (#66 M3/M4b).
        // `PairReviewToggle()` runs the branch IN draft nvim: with no review open
        // it drops into `:PairReview ` (tab-complete a file → a 100% review pane);
        // with one open it flips visibility (are-floating-panes-visible →
        // show/hide, never the toggle-floating-panes footgun). Doing the branch
        // in nvim — not in a transient 20%x1 floating shell pane — kills the
        // ~1s open delay, the auto-hide, and the half-size bugs the old
        // pair-review-toggle pane caused. When Alt+c is pressed from inside the
        // focused (floating) review pane, the shared router addresses draft
        // directly instead of hiding the review pane locally.
        bind "Alt c" { WriteChars "\u{1b}[99;3u"; }

        // Alt+l — open the session's distilled change log in a read-only nvim
        // viewer (#53). The distilled counterpart to Alt+/: pair-changelog-open
        // cleans the captured TTY, runs the pair-changelog distiller (LLM
        // distillation of what the operator saw, incremental across presses),
        // then runs nvim on the change-log markdown. <Esc>/q dismisses the
        // floating pane via close_on_exit.
        bind "Alt l" {
            Run "pair" "changelog" "open" {
                floating true
                close_on_exit true
                name "changelog"
                width "100%"
                height "100%"
                x "0"
                y "0"
            };
        }

        // Alt+n / Ctrl+Alt+n — reload the whole workbench with the same tag,
        // agent, args, and resumed agent conversation. Routed through nvim for
        // the same fat-finger guard as Alt+x.
        //
        // Ctrl+Alt+n is a duplicate alias for macOS users on Tahoe (and any
        // future OS / terminal combo that lets Option+n fire the dead-tilde
        // composer instead of forwarding it as Meta+n). Adding Ctrl to the
        // chord defeats the composer at the OS layer, so the binding
        // reaches zellij on the first press. Alt+n is kept for users whose
        // terminal is configured with Option-as-Meta.
        bind "Alt n" { WriteChars "\u{1b}[110;3u"; }
        bind "Ctrl Alt n" { WriteChars "\u{1b}[110;7u"; }

        // Shift+Alt+N — restart only the supervised agent child with a fresh
        // conversation. The zellij workbench, draft, and user terminal remain
        // alive; pair wrap reconstructs the launch without restoration args.
        bind "Alt N" { WriteChars "\u{1b}[78;4u"; }
    }
}
