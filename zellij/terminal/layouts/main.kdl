// Minimal inner zellij layout for Pair's right terminal pane.
//
// Do not include zellij's default tab-bar/status-bar plugins here; the right
// pane already lives inside Pair's outer zellij frame. Native tabs still exist
// and can be selected by mouse through zellij's pane frame/tab UI.

layout {
    tab name="terminal" {
        pane
    }
}
