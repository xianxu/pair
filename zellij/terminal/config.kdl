// Inner zellij config for Pair's right user terminal pane.
//
// The outer Pair zellij forwards Alt+t/w/r as Meta bytes to `pair term`.
// `pair term` runs this nested zellij under a PTY and passes those chords
// through, so tab operations stay inside the right pane instead of replacing
// the whole Pair workbench.

show_release_notes false

keybinds clear-defaults=false {
    normal {
        bind "Alt t" { NewTab; }
        bind "Alt w" { CloseTab; }
        bind "Alt r" { SwitchToMode "RenameTab"; TabNameInput 0; }
    }
}
