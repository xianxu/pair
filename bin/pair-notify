#!/usr/bin/env bash
# pair-notify — send an attention message to the owning wrapper
# from inside a pair (zellij) pane.
#
# Bounded broker delivery lives in the Go `pair notify` command. This shim
# remains because agent hook configurations invoke the stable pair-notify name.
#
# Usage:
#   pair-notify "Claude needs input"
#   pair-notify --osc 777 "Claude needs input"
#
# Intended for Claude Code Notification/Stop hooks. Designed to never
# fail loudly — if the owning wrapper broker is unavailable, exits 0 with
# a stderr warning so a misconfigured hook doesn't break the agent.

set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"

exec "$here/pair" notify "$@"
