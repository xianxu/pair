diff --git a/cmd/internal/couchcore/detach_measurement.go b/cmd/internal/couchcore/detach_measurement.go
new file mode 100644
index 000000000..eaead159f
--- /dev/null
+++ b/cmd/internal/couchcore/detach_measurement.go
@@ -0,0 +1,60 @@
+package couchcore
+
+// Disposable measurement only; never committed or installed.
+import (
+	"context"
+	"fmt"
+	dm "github.com/xianxu/pair/cmd/internal/detachmeasure"
+	"github.com/xianxu/pair/cmd/internal/launcher"
+	"time"
+)
+
+func detachMeasureRecord(event, thread string, elapsed time.Duration) {
+	dm.Record(event, thread, elapsed)
+}
+func detachMeasureBegin(ctx context.Context, operation string, address ThreadAddress) (context.Context, func()) {
+	if !dm.Enabled() {
+		return ctx, func() {}
+	}
+	thread := fmt.Sprintf("%s/%s", address.RepoScope, address.Tag)
+	ctx = dm.WithThread(ctx, thread)
+	if operation == "leave" {
+		dm.Start()
+		dm.Add(dm.Row{Event: "configured.parallelism", Parallelism: LifecycleParallelism})
+	}
+	begun := time.Now()
+	dm.Record(operation+".begin", thread, 0)
+	ctx = launcher.WithZellijQueryObserver(ctx, func(q launcher.ZellijQueryObservation) {
+		args := make([]string, 0, min(len(q.Args), 12))
+		for _, arg := range q.Args {
+			if len(args) == 12 {
+				break
+			}
+			if len(arg) > 256 {
+				arg = arg[:256]
+			}
+			args = append(args, arg)
+		}
+		dm.Add(dm.Row{Event: "zellij.query", Thread: thread, TimeNS: q.Finished.UnixNano(), StartedNS: q.Started.UnixNano(), DurationNS: q.Duration.Nanoseconds(), Args: args, Failed: q.Err != nil})
+	})
+	if operation == "detach" {
+		ctx = WithLaunchTimingObserver(ctx, func(step string, elapsed time.Duration) { dm.Record(step, thread, elapsed) })
+	}
+	return ctx, func() {
+		dm.Record(operation+".end", thread, time.Since(begun))
+		if operation == "leave" {
+			dm.CPU()
+			dm.Flush()
+		}
+	}
+}
+func DetachMeasurement(event, thread string, elapsed time.Duration) {
+	dm.Record(event, thread, elapsed)
+}
+
+func measurementStoreKey(s *ThreadStore) string {
+	if s == nil {
+		return "nil"
+	}
+	return dm.Key(s.root)
+}
diff --git a/cmd/internal/detachmeasure/trace.go b/cmd/internal/detachmeasure/trace.go
new file mode 100644
index 000000000..76a42154f
--- /dev/null
+++ b/cmd/internal/detachmeasure/trace.go
@@ -0,0 +1,133 @@
+// Package detachmeasure exists only in this disposable measurement clone.
+package detachmeasure
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+type Row struct {
+	Event        string   `json:"event"`
+	Thread       string   `json:"thread,omitempty"`
+	Key          string   `json:"key,omitempty"`
+	ID           uint64   `json:"id,omitempty"`
+	TimeNS       int64    `json:"time_ns"`
+	StartedNS    int64    `json:"started_ns,omitempty"`
+	DurationNS   int64    `json:"duration_ns,omitempty"`
+	Args         []string `json:"args,omitempty"`
+	Failed       bool     `json:"failed,omitempty"`
+	Parallelism  int      `json:"parallelism,omitempty"`
+	UserCPU_NS   int64    `json:"user_cpu_ns,omitempty"`
+	SystemCPU_NS int64    `json:"system_cpu_ns,omitempty"`
+}
+
+var state struct {
+	sync.Mutex
+	active   bool
+	rows     []Row
+	overhead int64
+	overflow bool
+	cpu      syscall.Rusage
+}
+var ids atomic.Uint64
+
+func Enabled() bool          { return os.Getenv("PAIR_DETACH_MEASURE_LOG") != "" }
+func NextID() uint64         { return ids.Add(1) }
+func Key(path string) string { return fmt.Sprintf("%x", sha256.Sum256([]byte(path)))[:16] }
+
+type threadKey struct{}
+
+func WithThread(ctx context.Context, thread string) context.Context {
+	return context.WithValue(ctx, threadKey{}, thread)
+}
+func Thread(ctx context.Context) string { value, _ := ctx.Value(threadKey{}).(string); return value }
+func Start() {
+	if !Enabled() {
+		return
+	}
+	state.Lock()
+	defer state.Unlock()
+	state.active = true
+	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &state.cpu)
+}
+func Add(row Row) {
+	if !Enabled() {
+		return
+	}
+	begun := time.Now()
+	if row.TimeNS == 0 {
+		row.TimeNS = begun.UnixNano()
+	}
+	state.Lock()
+	defer state.Unlock()
+	if !state.active && row.Event != "console.lifecycle.queue" {
+		return
+	}
+	if len(state.rows) < 4096 {
+		state.rows = append(state.rows, row)
+	} else {
+		state.overflow = true
+	}
+	state.overhead += time.Since(begun).Nanoseconds()
+}
+func Record(event, key string, elapsed time.Duration) {
+	Add(Row{Event: event, Thread: key, DurationNS: int64(elapsed)})
+}
+func Timer(event, key string, id uint64) func() {
+	if !Enabled() {
+		return func() {}
+	}
+	begun := time.Now()
+	return func() {
+		end := time.Now()
+		Add(Row{Event: event, Thread: key, ID: id, StartedNS: begun.UnixNano(), TimeNS: end.UnixNano(), DurationNS: end.Sub(begun).Nanoseconds()})
+	}
+}
+func CPU() {
+	var end syscall.Rusage
+	err := syscall.Getrusage(syscall.RUSAGE_SELF, &end)
+	state.Lock()
+	begin := state.cpu
+	state.Unlock()
+	delta := func(a, b syscall.Timeval) int64 { return (a.Sec-b.Sec)*1e9 + int64(a.Usec-b.Usec)*1000 }
+	Add(Row{Event: "whole_leave.process_cpu", UserCPU_NS: delta(end.Utime, begin.Utime), SystemCPU_NS: delta(end.Stime, begin.Stime), Failed: err != nil})
+}
+func Flush() {
+	begun := time.Now()
+	state.Lock()
+	state.active = false
+	rows := append([]Row(nil), state.rows...)
+	overhead, overflow := state.overhead, state.overflow
+	state.Unlock()
+	f, err := os.OpenFile(os.Getenv("PAIR_DETACH_MEASURE_LOG"), os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0600)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "measurement log:", err)
+		return
+	}
+	encoder := json.NewEncoder(f)
+	for _, row := range rows {
+		if err = encoder.Encode(row); err != nil {
+			break
+		}
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	if err == nil {
+		err = encoder.Encode(map[string]any{"event": "instrumentation", "observer_ns": overhead, "first_flush_ns": time.Since(begun).Nanoseconds(), "overflow": overflow})
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err != nil || closeErr != nil {
+		fmt.Fprintln(os.Stderr, "measurement log:", err, closeErr)
+	}
+}
